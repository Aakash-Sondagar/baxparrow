# ============ apps/api/.env ============
PORT=4000
MONGODB_URI=mongodb://localhost:27017/baxparrow
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
CLIENT_URL=http://localhost:5173

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=baxparrow

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Mail — Brevo recommended (free 300/day, verify Gmail as sender — no domain DNS needed)
# 1) https://app.brevo.com → SMTP & API → API keys → create key
# 2) Senders → Add sender → use baxsparrowweb@gmail.com → click verify link in inbox
# 3) Set below, restart API
BREVO_API_KEY=
MAIL_PROVIDER=brevo
MAIL_FROM=Baxsparrow <baxsparrowweb@gmail.com>

# Optional: Resend (needs verified domain for real inboxes; onboarding@resend.dev is broken for Gmail)
# RESEND_API_KEY=
# MAIL_PROVIDER=resend
# MAIL_FROM=Baxsparrow <onboarding@resend.dev>

# ============ apps/web/.env ============
VITE_API_URL=http://localhost:4000/api/v1
VITE_RAZORPAY_KEY_ID=
