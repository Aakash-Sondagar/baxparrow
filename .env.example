# ============ apps/api/.env ============
PORT=4000
MONGODB_URI=mongodb://localhost:27017/baxparrow
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
CLIENT_URL=http://localhost:5173
# Public URL inside emails (shop/track links). Use prod domain even when API runs locally.
MAIL_SITE_URL=https://dev.baxparrow.online

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=baxparrow

# Shiprocket
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# Mail — pick one provider
#
# Option A: Resend + your domain (prod — send to any customer)
# 1) resend.com/domains → add baxparrow.online → add DNS records
# 2) Set:
# MAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# MAIL_FROM=Baxsparrow <orders@baxparrow.online>
#
# Option B: Brevo (free 300/day — verify Gmail sender, no DNS)
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=Baxsparrow <baxsparrowweb@gmail.com>

# ============ apps/web/.env ============
VITE_API_URL=http://localhost:4000/api/v1
VITE_RAZORPAY_KEY_ID=
